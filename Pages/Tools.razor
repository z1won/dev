@page "/tools"
@layout MainLayout
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions

<PageTitle>Developer Tools · dev</PageTitle>

<div class="dashboard-header tools-header">
    <div><p class="eyebrow">Developer Tools / Workspace</p><h1>Browser-native utilities.</h1><p class="lead">Fast, local-first tools for formatting, decoding, matching and comparing data.</p></div>
    <div class="tools-status"><span class="status-dot"></span> LOCAL EXECUTION <span>·</span> NO BACKEND</div>
</div>

<div class="tools-shell">
    <aside class="tools-sidebar">
        <div class="tools-sidebar-title">TOOLS <span>@toolNames.Length</span></div>
        @foreach (var item in toolNames)
        {
            <button class="tool-nav-item @(activeTool == item ? "active" : "")" @onclick="() => activeTool = item"><span class="tool-nav-index">@GetToolIndex(item)</span><span><strong>@item</strong><small>@GetToolDescription(item)</small></span></button>
        }
    </aside>
    <main class="tool-main">
        <div class="tool-commandbar"><div><span class="command-prefix">dev/tools</span><span class="command-separator">/</span><strong>@activeTool</strong></div><span class="tool-note">INPUT → ACTION → OUTPUT</span></div>
        <section class="tool-workspace">
        @if (activeTool == "JSON")
        { <div class="tool-panel"><div class="tool-panel-heading"><div><span class="panel-kicker">FORMAT / VALIDATE</span><h2>JSON Formatter</h2></div><button class="action-button" @onclick="FormatJson">Format JSON</button></div><textarea class="tool-editor" @bind="jsonInput" spellcheck="false" placeholder="Paste JSON here..."></textarea><div class="output-label">OUTPUT</div><pre class="tool-output">@jsonOutput</pre></div> }
        else if (activeTool == "JWT")
        { <div class="tool-panel"><div class="tool-panel-heading"><div><span class="panel-kicker">INSPECT / DECODE</span><h2>JWT Decoder</h2></div><span class="tool-warning">⚠ Signature is not verified</span></div><textarea class="tool-editor compact" @bind="jwtInput" spellcheck="false" placeholder="eyJhbGciOi..."></textarea><button class="action-button" @onclick="DecodeJwt">Decode Token</button><div class="output-label">HEADER + PAYLOAD</div><pre class="tool-output">@jwtOutput</pre></div> }
        else if (activeTool == "REGEX")
        { <div class="tool-panel"><div class="tool-panel-heading"><div><span class="panel-kicker">MATCH / TEST</span><h2>Regex Tester</h2></div><button class="action-button" @onclick="TestRegex">Run Match</button></div><input class="tool-input" @bind="regexPattern" placeholder="Pattern, e.g. ^[A-Z]+$" /><textarea class="tool-editor compact" @bind="regexText" spellcheck="false" placeholder="Test text..."></textarea><div class="output-label">MATCHES</div><pre class="tool-output">@regexOutput</pre></div> }
        else if (activeTool == "DIFF")
        { <div class="tool-panel"><div class="tool-panel-heading"><div><span class="panel-kicker">COMPARE / REVIEW</span><h2>Text Diff</h2></div><button class="action-button" @onclick="CompareDiff">Compare</button></div><div class="diff-columns"><div><div class="editor-label">ORIGINAL</div><textarea class="tool-editor" @bind="diffLeft" spellcheck="false"></textarea></div><div><div class="editor-label">MODIFIED</div><textarea class="tool-editor" @bind="diffRight" spellcheck="false"></textarea></div></div><div class="output-label">DIFF RESULT</div><pre class="tool-output">@diffOutput</pre></div> }
        else if (activeTool == "BASE64")
        { <div class="tool-panel"><div class="tool-panel-heading"><div><span class="panel-kicker">ENCODE / DECODE</span><h2>Base64</h2></div><div><button class="action-button secondary" @onclick="EncodeBase64">Encode</button><button class="action-button" @onclick="DecodeBase64">Decode</button></div></div><textarea class="tool-editor compact" @bind="base64Input" spellcheck="false"></textarea><div class="output-label">RESULT</div><pre class="tool-output">@base64Output</pre></div> }
        else
        { <div class="tool-panel uuid-panel"><div><span class="panel-kicker">IDENTIFIER / GENERATE</span><h2>UUID Generator</h2></div><div class="uuid-value">@uuidValue</div><div class="uuid-meta"><span>VERSION 4</span><span>RANDOM IDENTIFIER</span></div><button class="action-button" @onclick="GenerateUuid">Generate UUID</button></div> }
        </section>
    </main>
</div>

@code {
    private readonly string[] toolNames = ["JSON", "JWT", "REGEX", "DIFF", "BASE64", "UUID"];
    private string activeTool = "JSON";
    private string jsonInput = "{\n  \"name\": \"dev\",\n  \"version\": 1\n}";
    private string jsonOutput = "";
    private string jwtInput = "";
    private string jwtOutput = "";
    private string regexPattern = "^[A-Z]+$";
    private string regexText = "HELLO\nBlazor\nWASM";
    private string regexOutput = "";
    private string diffLeft = "hello\nworld";
    private string diffRight = "hello\nblazor";
    private string diffOutput = "";
    private string base64Input = "Hello, Blazor!";
    private string base64Output = "";
    private string uuidValue = Guid.NewGuid().ToString();

    private string GetToolIndex(string tool) => (Array.IndexOf(toolNames, tool) + 1).ToString("00");
    private static string GetToolDescription(string tool) => tool switch { "JSON" => "Format & validate", "JWT" => "Decode token", "REGEX" => "Test patterns", "DIFF" => "Compare text", "BASE64" => "Encode & decode", _ => "Generate identifier" };
    private void FormatJson() { try { jsonOutput = JsonSerializer.Serialize(JsonDocument.Parse(jsonInput), new JsonSerializerOptions { WriteIndented = true }); } catch (Exception ex) { jsonOutput = $"Invalid JSON: {ex.Message}"; } }
    private void DecodeJwt() { try { var parts = jwtInput.Split('.'); if (parts.Length < 2) throw new FormatException("A JWT needs at least header and payload segments."); jwtOutput = $"HEADER\n{DecodeSegment(parts[0])}\n\nPAYLOAD\n{DecodeSegment(parts[1])}"; } catch (Exception ex) { jwtOutput = $"Invalid JWT: {ex.Message}"; } }
    private static string DecodeSegment(string value) { var padded = value.Replace('-', '+').Replace('_', '/') + new string('=', (4 - value.Length % 4) % 4); var json = Encoding.UTF8.GetString(Convert.FromBase64String(padded)); try { return JsonSerializer.Serialize(JsonDocument.Parse(json), new JsonSerializerOptions { WriteIndented = true }); } catch { return json; } }
    private void TestRegex() { try { regexOutput = string.Join(Environment.NewLine, Regex.Matches(regexText, regexPattern).Select(m => $"Match: {m.Value} @ {m.Index}")); if (string.IsNullOrEmpty(regexOutput)) regexOutput = "No matches."; } catch (Exception ex) { regexOutput = $"Invalid regex: {ex.Message}"; } }
    private void CompareDiff() { var left = diffLeft.Split('\n'); var right = diffRight.Split('\n'); var max = Math.Max(left.Length, right.Length); diffOutput = string.Join(Environment.NewLine, Enumerable.Range(0, max).Select(i => i >= left.Length ? $"+ {right[i]}" : i >= right.Length ? $"- {left[i]}" : left[i] == right[i] ? $"  {left[i]}" : $"- {left[i]}\n+ {right[i]}")); }
    private void EncodeBase64() => base64Output = Convert.ToBase64String(Encoding.UTF8.GetBytes(base64Input));
    private void DecodeBase64() { try { base64Output = Encoding.UTF8.GetString(Convert.FromBase64String(base64Input)); } catch (Exception ex) { base64Output = $"Invalid Base64: {ex.Message}"; } }
    private void GenerateUuid() => uuidValue = Guid.NewGuid().ToString();
}