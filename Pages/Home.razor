@page "/"
@layout MainLayout

<PageTitle>Dashboard · dev</PageTitle>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">Developer Portal</p>
        <h1>Good evening.</h1>
        <p class="lead">Your browser-native workspace for GitHub insights, developer utilities, and interactive experiments.</p>
    </div>
    <div class="header-chip"><span class="status-dot"></span> System ready</div>
</div>

<section class="metrics" aria-label="Portal overview">
    <article class="metric-card"><div class="metric-icon">◈</div><div><div class="metric-value">GitHub</div><div class="metric-label">Insights</div></div></article>
    <article class="metric-card"><div class="metric-icon">⌘</div><div><div class="metric-value">12+</div><div class="metric-label">Developer tools planned</div></div></article>
    <article class="metric-card"><div class="metric-icon">◌</div><div><div class="metric-value">WASM</div><div class="metric-label">Browser runtime</div></div></article>
    <article class="metric-card"><div class="metric-icon">⚡</div><div><div class="metric-value">.NET 10</div><div class="metric-label">Application stack</div></div></article>
</section>

<section class="section-block" id="github">
    <div class="section-heading"><div><p class="section-kicker">01 · Explore</p><h2>GitHub</h2></div><span class="coming-soon">Coming next</span></div>
    <div class="feature-grid">
        <article class="feature-card"><div class="feature-symbol">◫</div><h3>Repository overview</h3><p>Repositories, languages, stars, forks, and recent activity in one view.</p><button type="button" disabled>Open GitHub</button></article>
        <article class="feature-card"><div class="feature-symbol">↗</div><h3>Activity stream</h3><p>Commits, pull requests, issues, and contribution trends with lightweight charts.</p><button type="button" disabled>View activity</button></article>
    </div>
</section>

<section class="section-block" id="tools">
    <div class="section-heading"><div><p class="section-kicker">02 · Utilities</p><h2>Developer Tools</h2></div><span class="tool-count">6 modules</span></div>
    <div class="tool-grid">
        <div class="tool-card"><span>JSON</span><small>Format & validate</small></div>
        <div class="tool-card"><span>JWT</span><small>Decode tokens</small></div>
        <div class="tool-card"><span>REGEX</span><small>Test patterns</small></div>
        <div class="tool-card"><span>DIFF</span><small>Compare text</small></div>
        <div class="tool-card"><span>BASE64</span><small>Encode & decode</small></div>
        <div class="tool-card"><span>UUID</span><small>Generate IDs</small></div>
    </div>
</section>

<section class="section-block split-section" id="visualization">
    <div><p class="section-kicker">03 · Visualize</p><h2>Interactive visualization</h2><p>Charts, Git graphs, algorithm animations, and WebGL experiments will live here.</p></div>
    <div class="terminal-card"><div class="terminal-top"><span></span><span></span><span></span></div><code>dev.visualization<span> → </span>ready</code><div class="terminal-line">await workspace.StartAsync();</div></div>
</section>

<section class="section-block split-section" id="playground">
    <div><p class="section-kicker">04 · Experiment</p><h2>Playground</h2><p>A safe place for C# snippets, algorithms, WASM demos, and small browser experiments.</p></div>
    <div class="roadmap"><div><strong>01</strong><span>Foundation</span><em>done</em></div><div><strong>02</strong><span>Portal UI</span><em>current</em></div><div><strong>03</strong><span>GitHub API</span><em>next</em></div></div>
</section>
