@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">&gt;_</span><span>dev</span><small>DEVELOPER OS</small></div>
        <div class="nav-group">
            <div class="nav-label">Workspace</div>
            <nav>
                <a href="@NavManager.BaseUri"><span>⌂</span> Dashboard <kbd>01</kbd></a>
                <a href="@($"{NavManager.BaseUri}tools")"><span>⌘</span> Developer Tools <kbd>02</kbd></a>
                <a href="@($"{NavManager.BaseUri}visualization")"><span>◌</span> Visualization <kbd>03</kbd></a>
                <a href="@($"{NavManager.BaseUri}playground")"><span>▷</span> Playground <kbd>04</kbd></a>
                <a href="@($"{NavManager.BaseUri}algorithms")"><span>λ</span> Algorithms <kbd>05</kbd></a>
                <a href="@($"{NavManager.BaseUri}repositories")"><span>▦</span> Repositories <kbd>06</kbd></a>
            </nav>
        </div>
        <div class="nav-group">
            <div class="nav-label">Explore</div>
            <nav><a href="https://github.com/z1won"><span>◈</span> GitHub <kbd>↗</kbd></a></nav>
        </div>
        <div class="sidebar-footer">
            <div class="stack-badge"><span class="status-dot"></span> LOCAL RUNTIME</div>
            <div class="muted">.NET 10 · Blazor WebAssembly</div>
        </div>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <div class="topbar-route"><span class="topbar-title">dev</span><span class="topbar-separator">/</span><span class="topbar-path">@PageName</span></div>
            <div class="topbar-meta"><span class="topbar-status"><span class="status-dot"></span> Ready</span><span class="topbar-stack">WASM · CLIENT</span></div>
        </header>
        <section class="content">@Body</section>
    </main>
</div>

@code {
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private string PageName
    {
        get
        {
            var relative = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
            var segment = relative.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            return segment switch
            {
                "tools" => "tools",
                "visualization" => "visualization",
                "playground" => "playground",
                "algorithms" => "algorithms",
                "repositories" => "repositories",
                _ => "dashboard"
            };
        }
    }
}
