@page "/"
@using Microsoft.AspNetCore.Components.Web
@layout MainLayout

<PageTitle>Dashboard · dev</PageTitle>

<div class="hero">
    <p class="eyebrow">Developer Portal</p>
    <h1>dev</h1>
    <p class="lead">A .NET 10 Blazor WebAssembly workspace for developer tools, GitHub insights, and browser-native experiments.</p>
</div>

<div class="cards">
    <article class="card">
        <h2>GitHub</h2>
        <p>Repository activity, commits, pull requests, issues, and project metrics.</p>
    </article>
    <article class="card">
        <h2>Developer Tools</h2>
        <p>JSON, JWT, Regex, Markdown, Diff, encoding, and other browser-side utilities.</p>
    </article>
    <article class="card">
        <h2>Visualization</h2>
        <p>Interactive charts, Git graphs, algorithms, and future WebGL experiments.</p>
    </article>
</div>
