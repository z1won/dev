@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">&gt;_</span><span>dev</span></div>
        <div class="nav-group">
            <div class="nav-label">Workspace</div>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All"><span>⌂</span> Dashboard</NavLink>
                <NavLink href="/tools"><span>⌘</span> Developer Tools</NavLink>
                <NavLink href="/visualization"><span>◌</span> Visualization</NavLink>
            </nav>
        </div>
        <div class="nav-group">
            <div class="nav-label">Explore</div>
            <nav>
                <a href="/#github"><span>◈</span> GitHub</a>
                <a href="/#playground"><span>▷</span> Playground</a>
            </nav>
        </div>
        <div class="sidebar-footer"><div class="stack-badge">.NET 10</div><div class="muted">Blazor WebAssembly</div></div>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <div><span class="topbar-title">Developer Portal</span><span class="topbar-path">/ @PageName</span></div>
            <div class="topbar-status"><span class="status-dot"></span> Ready</div>
        </header>
        <section class="content">@Body</section>
    </main>
</div>

@code {
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    private string PageName => NavManager.Uri.TrimEnd('/').Split('/').LastOrDefault() switch
    {
        "tools" => "tools",
        "visualization" => "visualization",
        _ => "dashboard"
    };
}
