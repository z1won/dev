@page "/repositories/{RepositoryName}/pulls/{PullRequestNumber:int}"
@layout MainLayout
@inject GitHubApiClient GitHub
@inject NavigationManager NavManager

<PageTitle>PR #@PullRequestNumber · @RepositoryName · dev</PageTitle>

<div class="dashboard-commandbar">
    <div class="command-path"><span>dev</span><b>/</b><strong>pr/@RepositoryName/#@PullRequestNumber</strong></div>
    <div class="command-status"><span class="status-dot"></span> LIVE · PR INTELLIGENCE</div>
</div>

@if (loading)
{
    <section class="repository-detail-loading">Loading pull request intelligence…</section>
}
else if (error is not null)
{
    <div class="error-banner" role="alert">Pull request could not be loaded: @error</div>
    <a class="repository-back" href="@($"{NavManager.BaseUri}repositories/{Uri.EscapeDataString(RepositoryName)}")">← Repository</a>
}
else if (pullRequest is not null)
{
    <div class="repository-detail-head">
        <div>
            <a class="repository-back" href="@($"{NavManager.BaseUri}repositories/{Uri.EscapeDataString(RepositoryName)}")">← @RepositoryName</a>
            <p class="eyebrow">GitHub / Pull Request Intelligence</p>
            <h1>#@pullRequest.Number · @pullRequest.Title</h1>
            <p class="lead">@(pullRequest.Body ?? "No pull request description provided.")</p>
        </div>
        <a class="repository-github" href="@pullRequest.HtmlUrl" target="_blank" rel="noopener">Open on GitHub ↗</a>
    </div>

    <section class="repository-kpis pr-kpis">
        <div><span>STATUS</span><strong>@StatusLabel</strong></div>
        <div><span>BRANCH</span><strong>@pullRequest.HeadRef → @pullRequest.BaseRef</strong></div>
        <div><span>FILES</span><strong>@files.Count</strong></div>
        <div><span>HEAD</span><strong>@ShortSha(pullRequest.HeadSha)</strong></div>
    </section>

    <section class="pr-action-bar repository-panel">
        <div class="pr-action-copy"><span>REVIEW ACTION LAYER</span><small>Write operations open in GitHub; this public WASM client never stores credentials.</small></div>
        <div class="pr-actions">
            <a href="@pullRequest.HtmlUrl#issuecomment-new" target="_blank" rel="noopener">COMMENT</a>
            <a href="@pullRequest.HtmlUrl#pullrequest-review" target="_blank" rel="noopener">REVIEW</a>
            <a href="@pullRequest.HtmlUrl#files_bucket" target="_blank" rel="noopener">FILES</a>
        </div>
    </section>

    <section class="pr-intelligence-grid">
        <aside class="repository-panel pr-files-panel">
            <div class="repository-panel-head"><span>CHANGED FILES</span><small>@files.Count</small></div>
            @foreach (var file in files)
            {
                <button class="pr-file-node @(selectedFile == file.Filename ? "active" : "")" @onclick="() => SelectFileAsync(file.Filename ?? string.Empty)">
                    <span class="file-status">@(file.Status ?? "FILE")</span>
                    <span class="file-path">@file.Filename</span>
                    <span class="file-delta">+@file.Additions / -@file.Deletions</span>
                </button>
            }
            @if (files.Count == 0) { <div class="repository-empty">No changed files.</div> }
        </aside>

        <div class="pr-main-stack">
            <section class="repository-panel">
                <div class="repository-panel-head"><span>DIFF REVIEW</span><small>@(selectedFile ?? "all files")</small></div>
                @if (selectedFile is not null && filePatchLoading)
                {
                    <div class="repository-empty">Loading file patch…</div>
                }
                else if (selectedFile is not null && filePatch is not null)
                {
                    <pre class="pr-diff">@filePatch</pre>
                }
                else if (!string.IsNullOrWhiteSpace(prPatch))
                {
                    <pre class="pr-diff">@prPatch</pre>
                }
                else
                {
                    <div class="repository-empty">No diff available.</div>
                }
            </section>

            <section class="pr-stats-strip">
                <div><span>ADDITIONS</span><strong>+@additions</strong></div>
                <div><span>DELETIONS</span><strong>-@deletions</strong></div>
                <div><span>REVIEWS</span><strong>@reviews.Count</strong></div>
                <div><span>UNRESOLVED</span><strong>@unresolvedThreads</strong></div>
            </section>

            <section class="repository-panel">
                <div class="repository-panel-head"><span>REVIEW INTELLIGENCE</span><small>line-level context</small></div>
                @foreach (var thread in threads)
                {
                    <div class="pr-thread @(thread.IsResolved ? "resolved" : "")">
                        <div class="pr-thread-head"><span>INLINE THREAD</span><strong>@(thread.IsResolved ? "RESOLVED" : "UNRESOLVED")</strong></div>
                        <p>@thread.Body</p>
                        @if (!string.IsNullOrWhiteSpace(thread.Path))
                        {
                            <div class="pr-thread-location"><small>@thread.Path@(thread.Line is null ? "" : $":{thread.Line}")</small><a href="@GitHubFileUrl(thread.Path, thread.Line)" target="_blank" rel="noopener">OPEN FILE ↗</a></div>
                        }
                    </div>
                }
                @if (threads.Count == 0) { <div class="repository-empty">No inline review threads.</div> }
            </section>

            <section class="repository-panel">
                <div class="repository-panel-head"><span>REVIEW SUBMISSIONS</span><small>@reviews.Count</small></div>
                @foreach (var review in reviews)
                {
                    <div class="pr-review">
                        <div><strong>@(review.User?.Login ?? review.UserLogin ?? "unknown")</strong><span>@(review.State ?? "COMMENTED")</span></div>
                        <p>@(review.Body ?? "No review body.")</p>
                    </div>
                }
                @if (reviews.Count == 0) { <div class="repository-empty">No submitted reviews.</div> }
            </section>

            <section class="repository-panel">
                <div class="repository-panel-head"><span>CI INTELLIGENCE</span><small>@ciLabel · @checkRuns.Count checks</small></div>
                <div class="ci-summary"><strong>@ciLabel</strong><span>@ciDetail</span></div>
                @if (checkRuns.Count > 0)
                {
                    <div class="ci-checks">
                        @foreach (var check in checkRuns)
                        {
                            <a class="ci-check" href="@check.HtmlUrl" target="_blank" rel="noopener">
                                <span class="ci-check-state">@CheckLabel(check)</span>
                                <strong>@(check.Name ?? "Unnamed check")</strong>
                                <small>@(check.CompletedAt is null ? check.Status ?? "running" : $"{check.Status} · {check.Conclusion}")</small>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="repository-empty">No check runs reported for this commit.</div>
                }
            </section>
        </div>
    </section>
}

@code {
    [Parameter] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public int PullRequestNumber { get; set; }

    private PullRequestIntelligence? pullRequest;
    private IReadOnlyList<GitHubPullRequestFile> files = [];
    private IReadOnlyList<PullRequestReviewInfo> reviews = [];
    private IReadOnlyList<PullRequestThreadInfo> threads = [];
    private IReadOnlyList<GitHubCheckRun> checkRuns = [];
    private string? prPatch;
    private string? selectedFile;
    private string? filePatch;
    private bool loading;
    private bool filePatchLoading;
    private string? error;
    private string ciLabel = "NOT CHECKED";
    private string ciDetail = "Commit status is not available.";
    private int additions;
    private int deletions;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null; pullRequest = null; files = []; reviews = []; threads = []; checkRuns = []; prPatch = null; selectedFile = null; filePatch = null; additions = deletions = 0;
        try
        {
            var prTask = GitHub.GetPullRequestIntelligenceAsync("z1won", RepositoryName, PullRequestNumber);
            var filesTask = GitHub.GetPullRequestFilesAsync("z1won", RepositoryName, PullRequestNumber);
            var reviewsTask = GitHub.GetPullRequestReviewsAsync("z1won", RepositoryName, PullRequestNumber);
            var threadsTask = GitHub.GetPullRequestThreadsAsync("z1won", RepositoryName, PullRequestNumber);
            var diffTask = GitHub.GetPullRequestDiffAsync("z1won", RepositoryName, PullRequestNumber);
            await Task.WhenAll(prTask, filesTask, reviewsTask, threadsTask, diffTask);
            pullRequest = await prTask; files = await filesTask; reviews = await reviewsTask; threads = await threadsTask; prPatch = await diffTask;
            if (pullRequest is null) { error = "Pull request was not found."; return; }
            additions = pullRequest.Additions; deletions = pullRequest.Deletions;
            var statusTask = GitHub.GetCommitStatusAsync("z1won", RepositoryName, pullRequest.HeadSha);
            var checksTask = GitHub.GetCheckRunsAsync("z1won", RepositoryName, pullRequest.HeadSha);
            await Task.WhenAll(statusTask, checksTask);
            var status = await statusTask; ciLabel = status.Label; ciDetail = status.Detail; checkRuns = await checksTask;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task SelectFileAsync(string file)
    {
        if (string.IsNullOrWhiteSpace(file)) return;
        selectedFile = file; filePatch = null; filePatchLoading = true;
        try { filePatch = await GitHub.GetPullRequestFilePatchAsync("z1won", RepositoryName, PullRequestNumber, file); }
        catch (Exception ex) { filePatch = $"// Patch unavailable: {ex.Message}"; }
        finally { filePatchLoading = false; }
    }

    private int unresolvedThreads => threads.Count(x => !x.IsResolved);
    private string StatusLabel => pullRequest?.Draft == true ? "DRAFT" : (pullRequest?.State ?? "UNKNOWN").ToUpperInvariant();
    private static string ShortSha(string sha) => sha[..Math.Min(8, sha.Length)];
    private static string CheckLabel(GitHubCheckRun check) => check.Conclusion?.ToUpperInvariant() switch { "SUCCESS" => "PASS", "FAILURE" or "CANCELLED" or "TIMED_OUT" => "FAIL", _ => (check.Status ?? "PENDING").ToUpperInvariant() };
    private string GitHubFileUrl(string path, int? line) => $"https://github.com/z1won/{Uri.EscapeDataString(RepositoryName)}/blob/{Uri.EscapeDataString(pullRequest?.HeadSha ?? "master")}/{string.Join('/', path.Split('/').Select(Uri.EscapeDataString))}{(line is null ? "" : $"#L{line}")}";
}
