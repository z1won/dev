@page "/"
@layout MainLayout
@inject GitHubApiClient GitHub

<PageTitle>Dashboard · dev</PageTitle>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">Developer Portal</p>
        <h1>GitHub, in one view.</h1>
        <p class="lead">Live public GitHub insights powered directly from the browser with .NET 10 and Blazor WebAssembly.</p>
    </div>
    <button class="refresh-button" type="button" @onclick="LoadGitHubAsync" disabled="@loading">@(loading ? "Loading..." : "Refresh data")</button>
</div>

@if (error is not null)
{
    <div class="error-banner" role="alert">GitHub data could not be loaded: @error</div>
}

<section class="metrics" aria-label="GitHub overview">
    <article class="metric-card"><div class="metric-icon">◈</div><div><div class="metric-value">@(profile?.PublicRepos.ToString() ?? "—")</div><div class="metric-label">Public repositories</div></div></article>
    <article class="metric-card"><div class="metric-icon">★</div><div><div class="metric-value">@repositories.Sum(x => x.StargazersCount)</div><div class="metric-label">Stars in recent repos</div></div></article>
    <article class="metric-card"><div class="metric-icon">◌</div><div><div class="metric-value">@(profile?.Followers.ToString() ?? "—")</div><div class="metric-label">Followers</div></div></article>
    <article class="metric-card"><div class="metric-icon">⚡</div><div><div class="metric-value">@commits.Count</div><div class="metric-label">Recent commits loaded</div></div></article>
</section>

<section class="section-block" id="github">
    <div class="section-heading">
        <div><p class="section-kicker">01 · Live data</p><h2>GitHub</h2></div>
        <span class="coming-soon">@githubUser</span>
    </div>

    @if (profile is not null)
    {
        <div class="profile-card">
            <img src="@profile.AvatarUrl" alt="@profile.Login avatar" />
            <div><h3>@(profile.Name ?? profile.Login)</h3><p>@(profile.Bio ?? "GitHub profile")</p></div>
            <a href="@profile.HtmlUrl" target="_blank" rel="noopener">Open profile ↗</a>
        </div>
    }

    <div class="repo-grid">
        @if (loading && repositories.Count == 0)
        {
            <article class="empty-card">Loading repositories…</article>
        }
        else if (repositories.Count == 0)
        {
            <article class="empty-card">No public repositories found.</article>
        }
        else
        {
            @foreach (var repo in repositories)
            {
                <article class="repo-card">
                    <div class="repo-heading"><h3>@repo.Name</h3><span>@(repo.Language ?? "Code")</span></div>
                    <p>@(repo.Description ?? "No description")</p>
                    <div class="repo-meta"><span>★ @repo.StargazersCount</span><span>⑂ @repo.ForksCount</span><span>Updated @FormatDate(repo.UpdatedAt)</span></div>
                    @if (repo.HtmlUrl is not null)
                    {
                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener">Repository ↗</a>
                    }
                </article>
            }
        }
    </div>
</section>

<section class="section-block" id="activity">
    <div class="section-heading"><div><p class="section-kicker">02 · Recent work</p><h2>Activity</h2></div><span class="tool-count">Live GitHub</span></div>
    <div class="activity-grid">
        <div class="activity-card">
            <div class="activity-title"><h3>Commits</h3><span>@commits.Count</span></div>
            @if (loading && commits.Count == 0)
            {
                <p class="activity-empty">Loading commits…</p>
            }
            else if (commits.Count == 0)
            {
                <p class="activity-empty">No recent commits found.</p>
            }
            else
            {
                @foreach (var item in commits)
                {
                    <a class="activity-item" href="@item.HtmlUrl" target="_blank" rel="noopener">
                        <span class="activity-dot">●</span>
                        <span class="activity-body"><strong>@Shorten(item.Commit?.Message)</strong><small>@item.Author?.Login · @FormatDate(item.Commit?.Author?.Date)</small></span>
                    </a>
                }
            }
        </div>
        <div class="activity-card">
            <div class="activity-title"><h3>Pull requests</h3><span>@pullRequests.Count</span></div>
            @if (loading && pullRequests.Count == 0)
            {
                <p class="activity-empty">Loading pull requests…</p>
            }
            else if (pullRequests.Count == 0)
            {
                <p class="activity-empty">No recent pull requests found.</p>
            }
            else
            {
                @foreach (var item in pullRequests)
                {
                    <a class="activity-item" href="@item.HtmlUrl" target="_blank" rel="noopener">
                        <span class="activity-dot">↗</span>
                        <span class="activity-body"><strong>#{item.Number} · @item.Title</strong><small>@item.State@(item.Draft ? " · draft" : "") · @FormatDate(item.UpdatedAt)</small></span>
                    </a>
                }
            }
        </div>
        <div class="activity-card">
            <div class="activity-title"><h3>Issues</h3><span>@issues.Count</span></div>
            @if (loading && issues.Count == 0)
            {
                <p class="activity-empty">Loading issues…</p>
            }
            else if (issues.Count == 0)
            {
                <p class="activity-empty">No recent issues found.</p>
            }
            else
            {
                @foreach (var item in issues)
                {
                    <a class="activity-item" href="@item.HtmlUrl" target="_blank" rel="noopener">
                        <span class="activity-dot">#</span>
                        <span class="activity-body"><strong>#{item.Number} · @item.Title</strong><small>@item.State · @FormatDate(item.UpdatedAt)</small></span>
                    </a>
                }
            }
        </div>
    </div>
</section>

<section class="section-block" id="tools">
    <div class="section-heading"><div><p class="section-kicker">03 · Utilities</p><h2>Developer Tools</h2></div><span class="tool-count">Next</span></div>
    <div class="tool-grid">
        <div class="tool-card"><span>JSON</span><small>Format & validate</small></div>
        <div class="tool-card"><span>JWT</span><small>Decode tokens</small></div>
        <div class="tool-card"><span>REGEX</span><small>Test patterns</small></div>
        <div class="tool-card"><span>DIFF</span><small>Compare text</small></div>
        <div class="tool-card"><span>BASE64</span><small>Encode & decode</small></div>
        <div class="tool-card"><span>UUID</span><small>Generate IDs</small></div>
    </div>
</section>

<section class="section-block split-section" id="visualization">
    <div><p class="section-kicker">04 · Visualize</p><h2>Interactive visualization</h2><p>Charts, Git graphs, algorithm animations, and WebGL experiments will live here.</p></div>
    <div class="terminal-card"><div class="terminal-top"><span></span><span></span><span></span></div><code>github.api<span> → </span>connected</code><div class="terminal-line">GET /users/@githubUser/repos</div><div class="terminal-line">GET /repos/{owner}/{repo}/commits</div></div>
</section>

<section class="section-block split-section" id="playground">
    <div><p class="section-kicker">05 · Experiment</p><h2>Playground</h2><p>A safe place for C# snippets, algorithms, WASM demos, and small browser experiments.</p></div>
    <div class="roadmap"><div><strong>01</strong><span>Foundation</span><em>done</em></div><div><strong>02</strong><span>Portal UI</span><em>done</em></div><div><strong>03</strong><span>GitHub API</span><em>done</em></div><div><strong>04</strong><span>Activity feed</span><em>current</em></div><div><strong>05</strong><span>Developer tools</span><em>next</em></div></div>
</section>

@code {
    private const string githubUser = "z1won";
    private GitHubProfile? profile;
    private IReadOnlyList<GitHubRepository> repositories = [];
    private IReadOnlyList<GitHubCommit> commits = [];
    private IReadOnlyList<GitHubPullRequest> pullRequests = [];
    private IReadOnlyList<GitHubIssue> issues = [];
    private bool loading;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadGitHubAsync();

    private async Task LoadGitHubAsync()
    {
        loading = true;
        error = null;
        try
        {
            profile = await GitHub.GetProfileAsync(githubUser);
            repositories = (await GitHub.GetRepositoriesAsync(githubUser, 12)).Where(x => !x.Fork).ToList();

            var activityRepos = repositories.Take(4).ToList();
            var commitTasks = activityRepos.Select(repo => GitHub.GetCommitsAsync(githubUser, repo.Name, 3)).ToArray();
            var pullTasks = activityRepos.Select(repo => GitHub.GetPullRequestsAsync(githubUser, repo.Name, 3)).ToArray();
            var issueTasks = activityRepos.Select(repo => GitHub.GetIssuesAsync(githubUser, repo.Name, 3)).ToArray();

            var commitResults = await Task.WhenAll(commitTasks);
            var pullResults = await Task.WhenAll(pullTasks);
            var issueResults = await Task.WhenAll(issueTasks);

            commits = commitResults.SelectMany(x => x).OrderByDescending(x => x.Commit?.Author?.Date).Take(8).ToList();
            pullRequests = pullResults.SelectMany(x => x).OrderByDescending(x => x.UpdatedAt).Take(6).ToList();
            issues = issueResults.SelectMany(x => x).Where(x => x.PullRequest is null).OrderByDescending(x => x.UpdatedAt).Take(6).ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatDate(DateTimeOffset? date)
        => date is null ? "—" : date.Value.ToLocalTime().ToString("yyyy-MM-dd");

    private static string Shorten(string? message)
    {
        var firstLine = message?.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "No commit message";
        return firstLine.Length > 78 ? firstLine[..75] + "..." : firstLine;
    }
}
