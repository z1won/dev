@page "/repositories/{RepositoryName}/commits/{Sha}"
@layout MainLayout
@inject GitHubApiClient GitHub
@inject NavigationManager NavManager

<PageTitle>Commit @(ShortSha()) · @RepositoryName · dev</PageTitle>

<div class="dashboard-commandbar">
    <div class="command-path"><span>dev</span><b>/</b><strong>code/@RepositoryName/@ShortSha()</strong></div>
    <div class="command-status"><span class="status-dot"></span> CODE INTELLIGENCE · LIVE</div>
</div>

@if (loading)
{
    <section class="repository-detail-loading">Indexing commit graph and changed files…</section>
}
else if (error is not null)
{
    <div class="error-banner" role="alert">Commit could not be loaded: @error</div>
    <a class="repository-back" href="@RepositoryUrl()">← Repository</a>
}
else if (commit is not null)
{
    <div class="repository-detail-head">
        <div>
            <a class="repository-back" href="@RepositoryUrl()">← @RepositoryName</a>
            <p class="eyebrow">Code Intelligence / Commit Workspace</p>
            <h1>@ShortSha()</h1>
            <p class="lead">@ShortMessage(commit.Commit?.Message)</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(commit.HtmlUrl))
        {
            <a class="repository-github" href="@commit.HtmlUrl" target="_blank" rel="noopener">Open on GitHub ↗</a>
        }
    </div>

    <section class="repository-kpis">
        <div><span>COMMIT</span><strong>@ShortSha()</strong></div>
        <div><span>AUTHOR</span><strong>@(commit.Author?.Login ?? commit.Commit?.Author?.Name ?? "Unknown")</strong></div>
        <div><span>DELTA</span><strong>+@(commit.Stats?.Additions ?? 0) / -@(commit.Stats?.Deletions ?? 0)</strong></div>
        <div><span>FILES</span><strong>@(commit.Files?.Count ?? 0)</strong></div>
    </section>

    <section class="code-intelligence-workspace">
        <aside class="code-file-tree repository-panel">
            <div class="repository-panel-head"><span>CHANGED FILES</span><small>@(commit.Files?.Count ?? 0)</small></div>
            @if (commit.Files is not null && commit.Files.Count > 0)
            {
                @for (var i = 0; i < commit.Files.Count; i++)
                {
                    var file = commit.Files[i];
                    <button type="button" class="code-file-node @(selectedFileIndex == i ? "active" : "")" @onclick="() => SelectFile(i)">
                        <span class="file-status">@(file.Status ?? "M")</span>
                        <span class="file-path">@(file.Filename ?? "unknown")</span>
                        <span class="file-delta">+@file.Additions -@file.Deletions</span>
                    </button>
                }
            }
            else
            {
                <div class="repository-empty">No changed file details available.</div>
            }
        </aside>

        <div class="code-diff-pane">
            <div class="repository-panel code-context-panel">
                <div class="repository-panel-head"><span>COMMIT MESSAGE</span><small>@FormatDate(commit.Commit?.Author?.Date)</small></div>
                <pre class="commit-message">@(commit.Commit?.Message ?? "No commit message.")</pre>
            </div>

            <div class="repository-panel code-diff-panel">
                <div class="code-diff-head">
                    <div><span class="eyebrow">FILE / @activeView.ToUpperInvariant()</span><strong>@SelectedFilename()</strong></div>
                    <div class="code-view-tabs">
                        <button type="button" class="@(activeView == "diff" ? "active" : "")" @onclick="SetDiffView">DIFF</button>
                        <button type="button" class="@(activeView == "source" ? "active" : "")" @onclick="SetSourceView">SOURCE</button>
                    </div>
                    <div class="code-diff-meta"><span>+@(SelectedFile()?.Additions ?? 0)</span><span>-@(SelectedFile()?.Deletions ?? 0)</span></div>
                </div>
                @if (activeView == "diff")
                {
                    @if (!string.IsNullOrWhiteSpace(SelectedFile()?.Patch))
                    {
                        <pre class="intelligence-diff">@SelectedFile()!.Patch</pre>
                    }
                    else
                    {
                        <div class="repository-empty">GitHub did not return a patch for this file.</div>
                    }
                }
                else if (sourceLoading)
                {
                    <div class="repository-empty">Loading file snapshot at this commit…</div>
                }
                else if (sourceError is not null)
                {
                    <div class="repository-empty">@sourceError</div>
                }
                else if (!string.IsNullOrWhiteSpace(source?.DecodedContent))
                {
                    <div class="source-meta"><span>SNAPSHOT</span><span>@(source?.Path ?? SelectedFilename())</span><span>REF @ShortSha()</span></div>
                    <pre class="intelligence-source">@source!.DecodedContent</pre>
                }
                else
                {
                    <div class="repository-empty">Source content is unavailable for this file.</div>
                }
            </div>
        </div>
    </section>

    @if (commit.Parents is { Count: > 0 })
    {
        <section class="repository-panel compare-panel">
            <div class="repository-panel-head"><span>COMMIT INTELLIGENCE / COMPARE</span><small>BASE → HEAD</small></div>
            <div class="compare-toolbar">
                <div><span>BASE</span><strong>@ShortSha(selectedParentSha)</strong></div>
                <button type="button" class="refresh-button" @onclick="CompareWithParentAsync" disabled="@compareLoading">@(compareLoading ? "Comparing…" : "Compare parent → current")</button>
            </div>
            @if (compareError is not null)
            {
                <div class="repository-empty">@compareError</div>
            }
            else if (comparison is not null)
            {
                <div class="compare-metrics">
                    <div><span>STATUS</span><strong>@comparison.Status.ToUpperInvariant()</strong></div>
                    <div><span>COMMITS</span><strong>@comparison.TotalCommits</strong></div>
                    <div><span>FILES</span><strong>@(comparison.Files?.Count ?? 0)</strong></div>
                    <div><span>AHEAD</span><strong>+@comparison.AheadBy</strong></div>
                </div>
                @if (comparison.Files is { Count: > 0 })
                {
                    <div class="compare-files">
                        @foreach (var file in comparison.Files)
                        {
                            <div class="compare-file"><span>@(file.Status ?? "M")</span><strong>@(file.Filename ?? "unknown")</strong><small>+@file.Additions -@file.Deletions</small></div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="compare-empty">Select the immediate parent and run a comparison to inspect the complete commit delta.</div>
            }
        </section>
    }

    <section class="code-insight-strip">
        <div><span>CHANGESET</span><strong>@(commit.Stats?.Total ?? 0) lines</strong><small>total additions + deletions</small></div>
        <div><span>FOCUS</span><strong>@SelectedFilename()</strong><small>selected changed file</small></div>
        <div><span>GRAPH</span><strong>@(commit.Parents?.Count ?? 0) PARENT(S)</strong><small>commit ancestry available</small></div>
    </section>
}

@code {
    [Parameter] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public string Sha { get; set; } = string.Empty;

    private GitHubCommitDetail? commit;
    private GitHubFileContent? source;
    private GitHubCompareResult? comparison;
    private bool loading;
    private bool sourceLoading;
    private bool compareLoading;
    private string? error;
    private string? sourceError;
    private string? compareError;
    private int selectedFileIndex;
    private string activeView = "diff";
    private string? selectedParentSha;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null; source = null; comparison = null; sourceError = null; compareError = null; selectedFileIndex = 0; activeView = "diff"; selectedParentSha = null;
        try
        {
            commit = await GitHub.GetCommitAsync("z1won", RepositoryName, Sha);
            selectedParentSha = commit?.Parents?.FirstOrDefault()?.Sha;
            if (commit is null) error = "Commit was not found.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void SelectFile(int index)
    {
        selectedFileIndex = index;
        source = null;
        sourceError = null;
        activeView = "diff";
    }

    private void SetDiffView() => activeView = "diff";

    private async Task SetSourceView()
    {
        activeView = "source";
        if (source is not null || SelectedFile() is null) return;
        sourceLoading = true; sourceError = null;
        try
        {
            var path = SelectedFile()!.Filename;
            if (string.IsNullOrWhiteSpace(path)) { sourceError = "File path is unavailable."; return; }
            source = await GitHub.GetFileContentAsync("z1won", RepositoryName, path, Sha);
            if (source is null || string.IsNullOrWhiteSpace(source.DecodedContent)) sourceError = "GitHub did not return text source for this file.";
        }
        catch (Exception ex) { sourceError = ex.Message; }
        finally { sourceLoading = false; }
    }

    private async Task CompareWithParentAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedParentSha)) return;
        compareLoading = true; compareError = null; comparison = null;
        try
        {
            comparison = await GitHub.CompareCommitsAsync("z1won", RepositoryName, selectedParentSha, Sha);
            if (comparison is null) compareError = "GitHub returned no comparison data.";
        }
        catch (Exception ex) { compareError = ex.Message; }
        finally { compareLoading = false; }
    }

    private GitHubCommitFile? SelectedFile() => commit?.Files is { Count: > 0 } files && selectedFileIndex < files.Count ? files[selectedFileIndex] : null;
    private string SelectedFilename() => SelectedFile()?.Filename ?? "No file selected";
    private static string ShortSha(string? sha) => string.IsNullOrWhiteSpace(sha) ? "unknown" : sha[..Math.Min(10, sha.Length)];
    private string ShortSha() => ShortSha(Sha);
    private string RepositoryUrl() => $"{NavManager.BaseUri}repositories/{Uri.EscapeDataString(RepositoryName)}";
    private static string ShortMessage(string? message){var firstLine=message?.Split('\n',StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim();return string.IsNullOrWhiteSpace(firstLine)?"Untitled commit":firstLine;}
    private static string FormatDate(DateTimeOffset? date) => date is null ? "—" : date.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
