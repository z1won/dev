@page "/visualization"
@layout MainLayout
@inject GitHubApiClient GitHub

<PageTitle>Visualization · dev</PageTitle>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">04 · Visualize</p>
        <h1>GitHub visualization.</h1>
        <p class="lead">Turn public repository metadata into lightweight SVG and CSS visualizations. No chart library required.</p>
    </div>
    <button class="refresh-button" type="button" @onclick="LoadAsync" disabled="@loading">@(loading ? "Loading..." : "Refresh")</button>
</div>

@if (error is not null)
{
    <div class="error-banner" role="alert">GitHub data could not be loaded: @error</div>
}

@if (loading && repositories.Count == 0)
{
    <div class="viz-loading">Loading GitHub statistics…</div>
}
else
{
    <section class="viz-grid">
        <article class="viz-card viz-wide">
            <div class="viz-heading"><div><p class="section-kicker">Language distribution</p><h2>What @githubUser builds with</h2></div><span>@languageStats.Count languages</span></div>
            @if (languageStats.Count == 0)
            {
                <p class="viz-empty">No language metadata is available.</p>
            }
            else
            {
                <div class="donut-layout">
                    <div class="donut" style="--p1:@LanguagePercent(0); --p2:@LanguagePercent(1); --p3:@LanguagePercent(2); --p4:@LanguagePercent(3);" aria-label="Language distribution chart">
                        <div class="donut-hole"><strong>@repositories.Count</strong><small>repos</small></div>
                    </div>
                    <div class="legend">
                        @for (var i = 0; i < Math.Min(languageStats.Count, 6); i++)
                        {
                            var item = languageStats[i];
                            <div class="legend-row"><span class="legend-dot"></span><span>@item.Language</span><strong>@item.Count</strong><small>@item.Percent.ToString("0.#")%</small></div>
                        }
                    </div>
                </div>
            }
        </article>

        <article class="viz-card">
            <div class="viz-heading"><div><p class="section-kicker">Repository reach</p><h2>Stars & forks</h2></div></div>
            <div class="bar-chart">
                @foreach (var repo in repositories.Take(8))
                {
                    var max = Math.Max(1, repositories.Take(8).Max(x => Math.Max(x.StargazersCount, x.ForksCount)));
                    <div class="bar-row">
                        <span title="@repo.Name">@ShortName(repo.Name)</span>
                        <div class="bars"><i style="width:@BarWidth(repo.StargazersCount, max)%" title="@repo.StargazersCount stars"></i><b style="width:@BarWidth(repo.ForksCount, max)%" title="@repo.ForksCount forks"></b></div>
                    </div>
                }
            </div>
            <div class="chart-key"><span>★ Stars</span><span>⑂ Forks</span></div>
        </article>

        <article class="viz-card">
            <div class="viz-heading"><div><p class="section-kicker">Repository activity</p><h2>Recent updates</h2></div></div>
            <div class="activity-bars">
                @foreach (var repo in repositories.OrderByDescending(x => x.UpdatedAt).Take(8))
                {
                    <div class="activity-bar-row"><span>@ShortName(repo.Name)</span><div><i style="height:@ActivityHeight(repo)%"></i></div><small>@FormatDate(repo.UpdatedAt)</small></div>
                }
            </div>
        </article>
    </section>

    <section class="section-block">
        <div class="section-heading"><div><p class="section-kicker">Repository ranking</p><h2>Top repositories</h2></div><span class="tool-count">@repositories.Count public repos loaded</span></div>
        <div class="repo-table">
            <div class="repo-table-head"><span>Repository</span><span>Language</span><span>Stars</span><span>Forks</span></div>
            @foreach (var repo in repositories.OrderByDescending(x => x.StargazersCount).ThenByDescending(x => x.ForksCount).Take(10))
            {
                <a class="repo-table-row" href="@repo.HtmlUrl" target="_blank" rel="noopener"><strong>@repo.Name</strong><span>@(repo.Language ?? "—")</span><span>★ @repo.StargazersCount</span><span>⑂ @repo.ForksCount</span></a>
            }
        </div>
    </section>
}

@code {
    private const string githubUser = "z1won";
    private IReadOnlyList<GitHubRepository> repositories = [];
    private List<LanguageStat> languageStats = [];
    private bool loading;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            repositories = (await GitHub.GetRepositoriesAsync(githubUser, 100)).Where(x => !x.Fork).ToList();
            var total = repositories.Count;
            languageStats = repositories
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Language) ? "Other" : x.Language!)
                .Select(g => new LanguageStat(g.Key, g.Count(), total == 0 ? 0 : g.Count() * 100d / total))
                .OrderByDescending(x => x.Count)
                .ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private double LanguagePercent(int index) => index < languageStats.Count ? languageStats[index].Percent : 0;

    private static int BarWidth(int value, int max) => value == 0 ? 0 : Math.Max(3, (int)Math.Round(value * 100d / max));

    private int ActivityHeight(GitHubRepository repo)
    {
        var days = repo.UpdatedAt is null ? 365 : Math.Max(0, (DateTimeOffset.UtcNow - repo.UpdatedAt.Value).TotalDays);
        return Math.Clamp(92 - (int)(days / 4), 18, 92);
    }

    private static string ShortName(string name) => name.Length > 18 ? name[..17] + "…" : name;
    private static string FormatDate(DateTimeOffset? date) => date is null ? "—" : date.Value.ToLocalTime().ToString("MM-dd");
    private sealed record LanguageStat(string Language, int Count, double Percent);
}
