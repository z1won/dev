@page "/"
@layout MainLayout
@inject GitHubApiClient GitHub

<PageTitle>Dashboard · dev</PageTitle>

<div class="dashboard-commandbar">
    <div class="command-path"><span>dev</span><b>/</b><strong>dashboard</strong></div>
    <div class="command-status"><span class="status-dot"></span> LIVE · github.com/@githubUser</div>
</div>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">Developer Portal / Overview</p>
        <h1>GitHub, in one view.</h1>
        <p class="lead">Live public GitHub telemetry, recent work, and browser-native developer utilities.</p>
    </div>
    <button class="refresh-button" type="button" @onclick="LoadGitHubAsync" disabled="@loading">@(loading ? "Loading..." : "Refresh data")</button>
</div>

@if (error is not null)
{
    <div class="error-banner" role="alert">GitHub data could not be loaded: @error</div>
}

<section class="metrics" aria-label="GitHub overview">
    <article class="metric-card"><div class="metric-icon">◈</div><div><div class="metric-value">@(profile?.PublicRepos.ToString() ?? "—")</div><div class="metric-label">Public repos</div></div><span class="metric-tag">API</span></article>
    <article class="metric-card"><div class="metric-icon">★</div><div><div class="metric-value">@repositories.Sum(x => x.StargazersCount)</div><div class="metric-label">Stars · sampled repos</div></div><span class="metric-tag">LIVE</span></article>
    <article class="metric-card"><div class="metric-icon">◌</div><div><div class="metric-value">@(profile?.Followers.ToString() ?? "—")</div><div class="metric-label">Followers</div></div><span class="metric-tag">PROFILE</span></article>
    <article class="metric-card"><div class="metric-icon">⚡</div><div><div class="metric-value">@timeline.Count</div><div class="metric-label">Recent events</div></div><span class="metric-tag">18 MAX</span></article>
</section>

<section class="section-block" id="github">
    <div class="section-heading">
        <div><p class="section-kicker">01 · LIVE DATA</p><h2>GitHub repositories</h2></div>
        <span class="section-command">GET /users/@githubUser/repos</span>
    </div>

    @if (profile is not null)
    {
        <div class="profile-card">
            <img src="@profile.AvatarUrl" alt="@profile.Login avatar" />
            <div><h3>@(profile.Name ?? profile.Login)</h3><p>@(profile.Bio ?? "GitHub profile")</p></div>
            <a href="@profile.HtmlUrl" target="_blank" rel="noopener">Open profile ↗</a>
        </div>
    }

    <div class="repo-grid">
        @if (loading && repositories.Count == 0)
        {
            <article class="empty-card">Loading repositories…</article>
        }
        else if (repositories.Count == 0)
        {
            <article class="empty-card">No public repositories found.</article>
        }
        else
        {
            @foreach (var repo in repositories)
            {
                <article class="repo-card">
                    <div class="repo-heading"><h3>@repo.Name</h3><span>@(repo.Language ?? "Code")</span></div>
                    <p>@(repo.Description ?? "No description")</p>
                    <div class="repo-meta"><span>★ @repo.StargazersCount</span><span>⑂ @repo.ForksCount</span><span>Updated @FormatDate(repo.UpdatedAt)</span></div>
                    @if (repo.HtmlUrl is not null)
                    {
                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener">Repository ↗</a>
                    }
                </article>
            }
        }
    </div>
</section>

<section class="section-block" id="activity">
    <div class="section-heading">
        <div><p class="section-kicker">02 · EVENT STREAM</p><h2>Activity timeline</h2></div>
        <span class="section-command">@timeline.Count events · @activityRepoCount repos</span>
    </div>

    <div class="activity-summary">
        <span><b>@commits.Count</b> commits</span>
        <span><b>@pullRequests.Count</b> pull requests</span>
        <span><b>@issues.Count</b> issues</span>
        <span class="activity-scope">Latest activity across sampled repositories</span>
    </div>

    <div class="timeline-card">
        @if (loading && timeline.Count == 0)
        {
            <p class="activity-empty">Loading activity…</p>
        }
        else if (timeline.Count == 0)
        {
            <p class="activity-empty">No recent activity found.</p>
        }
        else
        {
            @foreach (var item in timeline)
            {
                <a class="timeline-item" href="@item.Url" target="_blank" rel="noopener">
                    <span class="timeline-marker @item.TypeClass">@item.Icon</span>
                    <span class="timeline-content">
                        <span class="timeline-topline"><b class="activity-type">@item.Type</b><span class="activity-repo">@item.Repository</span><time>@FormatRelative(item.Date)</time></span>
                        <strong>@item.Title</strong>
                        <small>@item.Detail</small>
                    </span>
                    <span class="timeline-arrow">↗</span>
                </a>
            }
        }
    </div>
</section>

<section class="section-block" id="tools">
    <div class="section-heading"><div><p class="section-kicker">03 · TOOLCHAIN</p><h2>Developer Tools</h2></div><a class="section-command section-link" href="tools">OPEN /tools ↗</a></div>
    <div class="tool-grid">
        @foreach (var tool in dashboardTools)
        {
            <a class="dashboard-tool-link" href="tools"><div class="tool-card"><span>@tool.Name</span><small>@tool.Description</small></div></a>
        }
    </div>
</section>

<section class="section-block split-section" id="visualization">
    <div><p class="section-kicker">04 · ANALYTICS</p><h2>GitHub Visualization</h2><p>Repository reach, technology footprint, update recency, and sampled commit activity in a dense analytics view.</p><a class="inline-route" href="visualization">Open visualization ↗</a></div>
    <div class="terminal-card"><div class="terminal-top"><span></span><span></span><span></span></div><code>github.api<span> → </span>connected</code><div class="terminal-line">GET /users/@githubUser/repos</div><div class="terminal-line">GET /repos/{owner}/{repo}/commits</div><div class="terminal-line">STATUS <span class="terminal-ok">200 OK</span></div></div>
</section>

<section class="section-block split-section" id="playground">
    <div><p class="section-kicker">05 · EXPERIMENTS</p><h2>Algorithm Playground</h2><p>Interactive sorting, searching, graph traversal, and execution telemetry built directly in Blazor WebAssembly.</p><a class="inline-route" href="playground">Open playground ↗</a></div>
    <div class="roadmap"><div><strong>01</strong><span>Foundation</span><em>done</em></div><div><strong>02</strong><span>Portal UI</span><em>done</em></div><div><strong>03</strong><span>GitHub API</span><em>done</em></div><div><strong>04</strong><span>Activity timeline</span><em>done</em></div><div><strong>05</strong><span>Dense UI + Developer Tools</span><em>done</em></div><div><strong>06</strong><span>Playground + Analytics</span><em>current</em></div></div>
</section>

@code {
    private const string githubUser = "z1won";
    private readonly (string Name, string Description)[] dashboardTools =
    [
        ("JSON", "Format & validate"), ("JWT", "Decode tokens"), ("REGEX", "Test patterns"),
        ("DIFF", "Compare text"), ("BASE64", "Encode & decode"), ("UUID", "Generate IDs")
    ];
    private GitHubProfile? profile;
    private IReadOnlyList<GitHubRepository> repositories = [];
    private IReadOnlyList<GitHubCommit> commits = [];
    private IReadOnlyList<GitHubPullRequest> pullRequests = [];
    private IReadOnlyList<GitHubIssue> issues = [];
    private List<ActivityEvent> timeline = [];
    private bool loading;
    private string? error;
    private int activityRepoCount;

    protected override async Task OnInitializedAsync() => await LoadGitHubAsync();

    private async Task LoadGitHubAsync()
    {
        loading = true;
        error = null;
        try
        {
            profile = await GitHub.GetProfileAsync(githubUser);
            repositories = (await GitHub.GetRepositoriesAsync(githubUser, 12)).Where(x => !x.Fork).ToList();
            var activityRepos = repositories.Take(4).ToList();
            activityRepoCount = activityRepos.Count;
            var commitTasks = activityRepos.Select(repo => GitHub.GetCommitsAsync(githubUser, repo.Name, 3)).ToArray();
            var pullTasks = activityRepos.Select(repo => GitHub.GetPullRequestsAsync(githubUser, repo.Name, 3)).ToArray();
            var issueTasks = activityRepos.Select(repo => GitHub.GetIssuesAsync(githubUser, repo.Name, 3)).ToArray();
            var commitResults = await Task.WhenAll(commitTasks);
            var pullResults = await Task.WhenAll(pullTasks);
            var issueResults = await Task.WhenAll(issueTasks);

            var commitItems = commitResults.SelectMany((items, repoIndex) => items.Select(item => new ActivityEvent(
                "Commit", "commit", "●", activityRepos[repoIndex].Name, Shorten(item.Commit?.Message),
                $"{item.Author?.Login ?? "GitHub user"} · {FormatDate(item.Commit?.Author?.Date)}",
                item.Commit?.Author?.Date, item.HtmlUrl))).ToList();
            var pullItems = pullResults.SelectMany((items, repoIndex) => items.Select(item => new ActivityEvent(
                "Pull request", "pull", "↗", activityRepos[repoIndex].Name, $"#{item.Number} · {item.Title}",
                $"{item.State}{(item.Draft ? " · draft" : "")} · {FormatDate(item.UpdatedAt)}",
                item.UpdatedAt, item.HtmlUrl))).ToList();
            var issueItems = issueResults.SelectMany((items, repoIndex) => items.Where(item => item.PullRequest is null).Select(item => new ActivityEvent(
                "Issue", "issue", "#", activityRepos[repoIndex].Name, $"#{item.Number} · {item.Title}",
                $"{item.State} · {FormatDate(item.UpdatedAt)}",
                item.UpdatedAt, item.HtmlUrl))).ToList();

            commits = commitResults.SelectMany(x => x).OrderByDescending(x => x.Commit?.Author?.Date).Take(8).ToList();
            pullRequests = pullResults.SelectMany(x => x).OrderByDescending(x => x.UpdatedAt).Take(6).ToList();
            issues = issueResults.SelectMany(x => x).Where(x => x.PullRequest is null).OrderByDescending(x => x.UpdatedAt).Take(6).ToList();
            timeline = commitItems.Concat(pullItems).Concat(issueItems).OrderByDescending(x => x.Date ?? DateTimeOffset.MinValue).Take(18).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private static string FormatDate(DateTimeOffset? date) => date is null ? "—" : date.Value.ToLocalTime().ToString("yyyy-MM-dd");
    private static string FormatRelative(DateTimeOffset? date)
    {
        if (date is null) return "—";
        var age = DateTimeOffset.UtcNow - date.Value.ToUniversalTime();
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{Math.Max(1, (int)age.TotalMinutes)}m ago";
        if (age.TotalDays < 1) return $"{Math.Max(1, (int)age.TotalHours)}h ago";
        if (age.TotalDays < 7) return $"{Math.Max(1, (int)age.TotalDays)}d ago";
        return date.Value.ToLocalTime().ToString("MMM d");
    }
    private static string Shorten(string? message)
    {
        var firstLine = message?.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "No commit message";
        return firstLine.Length > 78 ? firstLine[..75] + "..." : firstLine;
    }
    private sealed record ActivityEvent(string Type, string TypeClass, string Icon, string Repository, string Title, string Detail, DateTimeOffset? Date, string? Url);
}
